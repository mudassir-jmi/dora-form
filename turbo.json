{
    "$schema": "https://turborepo.com/schema.json",
    "ui": "tui",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "env": [
                "NEXT_PUBLIC_API_URL",
                "NODE_ENV",
                "PORT",
                "BACKEND_PORT",
                "FRONTEND_PORT",
                "BASE_URL",
                "ALLOWED_ORIGIN"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                ".env*"
            ],
            "outputs": [
                ".next/**",
                "!.next/cache/**",
                "dist/**"
            ]
        },
        "lint": {
            "dependsOn": [
                "^lint"
            ]
        },
        "check-types": {
            "dependsOn": [
                "^check-types"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "db:generate": {},
        "db:migrate": {}
    }
}
